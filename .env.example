# GEMINI_API_KEY: Default single Gemini AI API key.
GEMINI_API_KEY=""

# Multi-Project Quota Keys: Up to 5 (or more) API keys from separate Google Cloud projects
# The server-side quota-aware scheduler pools their limits and routes requests across projects.
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram Notifications
# Optional: Setup Telegram notifications when translation is completed or paused
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_IDS=""
TELEGRAM_STATUS_INTERVAL_MIN="5" # Optional: Interval in minutes for periodic progress reports (default is 5)

# MASTER_PASSCODE: Set a password to protect the web UI gate. Leave empty for open access.
MASTER_PASSCODE=""
